# Paths are supplied by the caller and must stay outside Git.
DATASET_ROOT=/path/to/parquet-dataset
RUN_DIR=/path/to/run
MODEL_TYPE=wavlm
MODEL_NAME_OR_PATH=microsoft/wavlm-base-plus

# Reusable training controls.
ACTIVE_SCOPE=20
CLASSIFIER_HEAD_TYPE=clean_taxonomy
NPROC_PER_NODE=8
BATCH_SIZE=4
EVAL_BATCH_SIZE=8
GRADIENT_ACCUMULATION_STEPS=4
LEARNING_RATE=2e-5
HEAD_LEARNING_RATE=2e-4
MAX_TRAIN_STEPS=100000
SAVE_EVERY_STEPS=5000
EVAL_EVERY_STEPS=5000
CHUNK_SECONDS=30
PRECISION=bf16
